---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/projects/perception", label: "Perception Model" },
  { href: "/projects/point-cloud", label: "3D / Point Cloud" },
  { href: "/projects/agriculture", label: "Agricultural Lab" },
];
---

<header class="nav-wrap">
  <div class="container nav-inner">
    <a href="/" class="brand">Arjun Nanda Kumar</a>
    <nav>
      {links.map((link) => (
        <a
          href={link.href}
          class={currentPath === link.href ? "active" : ""}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: rgba(11, 13, 16, 0.75);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
  }

  nav {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  nav a {
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--text);
  }
</style>
