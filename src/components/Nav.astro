---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#pointcloud", label: "Point Cloud" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="nav-wrap">
  <div class="container nav-inner">
    <a href="/" class="brand">Arjun Nanda Kumar</a>
    <nav>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: rgba(8, 9, 11, 0.7);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .brand {
    font-weight: 650;
    text-decoration: none;
    font-size: 1rem;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--accent);
  }
</style>
