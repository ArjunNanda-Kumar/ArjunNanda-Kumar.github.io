---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal';
import ModelViewer from '../components/ModelViewer';
import CartoonAvatar from '../components/CartoonAvatar';
const work = [
{
index: 'SYS-01',
tag: 'HORC Lab · Humanoid Perception',
title: 'Perception on Agility Digit',
desc: 'Working on the perception model for the Agility Digit humanoid robot in the Human-Oriented Robotics and Control (HORC) Lab at the University of Delaware.',
},
{
index: 'SYS-02',
tag: 'ROS 2 · Sensor Transport',
title: 'Lidar Streaming Bottleneck',
desc: 'Diagnosed why a ROS 2 node streaming lidar and camera data over TCP/WebSockets was frame-rate capped, and proposed a restructured drain-loop fix.',
},
{
index: 'SYS-03',
tag: 'ROS 2 · IMU · Raspberry Pi',
title: 'IMU Pipeline on Raspberry Pi',
desc: 'A sensor-to-analysis pipeline on a Raspberry Pi Zero 2W over SSH: a ROS 2 node processing live IMU data, logged to CSV and plotted with pandas and matplotlib.',
},
];
const listings = [
{
source: 'UD Mechanical Engineering',
role: 'Graduate Student Directory',
text: 'MSME program, research area Robotics.',
href: 'https://me.udel.edu/people/graduate-students/',
},
{
source: 'HORC Lab',
role: 'Human-Oriented Robotics & Control',
text: "Robotics master's student, bachelor's in mechanical engineering, working on the perception model for the Agility Digit.",
href: 'https://horc-lab.github.io/people/',
},
{
source: 'Ag-CyPhER Lab',
role: 'Agricultural Cyber-Physical Systems',
text: 'Research assistant, MS Robotics, 2026 to present.',
href: 'https://ag-cypher.github.io/website/',
},
{
source: 'Horn Entrepreneurship',
role: '2026 Hen Hatch Finalists',
text: '2026 Hen Hatch finalist with Agri Sky Eye. Finals December 3, 2026.',
href: 'https://horn.udel.edu/meet-the-2026-hen-hatch-finalists',
},
];
---
<BaseLayout>
<!-- HERO SECTION -->
<section class="hero section container">
<div class="hero-bg-avatar" aria-hidden="true">
<CartoonAvatar client:load />
</div>
<div class="hero-grid">
<div class="hero-copy">
<Reveal client:load>
<div class="eyebrow-row">
<span class="status-pill">
<span class="status-dot"></span>
MS ROBOTICS @ UNIVERSITY OF DELAWARE
</span>
<span class="mono-tag">HORC LAB · AG-CYPHER LAB</span>
</div>
</Reveal>
<Reveal client:load delay={0.08}>
<h1 class="hero-title">
Engineering things that <span class="accent">sense</span>, <span class="accent">move</span>, and hold together.
</h1>
</Reveal>
<Reveal client:load delay={0.16}>
<p class="hero-lead">
I’m <strong>Arjun Nanda Kumar</strong>, a Robotics master’s student (MSME program) at the University of Delaware with a bachelor’s in mechanical engineering. I work on the perception model for the <strong>Agility Digit</strong> humanoid at the HORC Lab and am a research assistant at the <strong>Ag-CyPhER Lab</strong>.
</p>
</Reveal>
<Reveal client:load delay={0.24}>
<div class="hero-actions">
<a href="#work" class="btn">Explore Engineering Work</a>
<a href="#pointcloud" class="btn btn-ghost">Inspect Live LiDAR Scan</a>
</div>
</Reveal>
<Reveal client:load delay={0.32}>
<div class="hero-telemetry">
<div class="telemetry-item">
<span class="telemetry-key">HUMANOID PLATFORM</span>
<span class="telemetry-val">Agility Digit</span>
</div>
<div class="telemetry-item">
<span class="telemetry-key">VENTURE TRACK</span>
<span class="telemetry-val">2026 Hen Hatch Finalist</span>
</div>
<div class="telemetry-item">
<span class="telemetry-key">STACK</span>
<span class="telemetry-val">ROS 2 · Python · Linux</span>
</div>
</div>
</Reveal>
</div>
</div>
</section>
<!-- 01 // WORK SECTION -->
<section id="work" class="section container">
<Reveal client:visible>
<div class="section-header">
<div>
<p class="eyebrow">01 // RESEARCH & SYSTEMS ENGINEERING</p>
<h2 class="section-title">Selected Robotics Work</h2>
</div>
<span class="section-meta mono-dim">PERCEPTION · SENSORS · EMBEDDED</span>
</div>
</Reveal>
<div class="work-grid">
{work.map((item, i) => (
<Reveal client:visible delay={i * 0.1}>
<article class="card work-card">
<div class="card-top-bar">
<span class="mono-index">{item.index}</span>
<span class="work-tag">{item.tag}</span>
</div>
<h3 class="work-title">{item.title}</h3>
<p class="work-desc">{item.desc}</p>
</article>
</Reveal>
))}
</div>
</section>
<!-- 02 // VENTURE SECTION -->
<section id="venture" class="section container">
<Reveal client:visible>
<div class="section-header">
<div>
<p class="eyebrow">02 // AGRICULTURAL ROBOTICS VENTURE</p>
<h2 class="section-title">Agri Sky Eye</h2>
</div>
<span class="section-meta mono-dim">CABLE-DRIVEN PRECISION AGRICULTURE</span>
</div>
</Reveal>
<Reveal client:visible delay={0.08}>
<div class="card venture-card">
<div class="venture-top">
<span class="badge-finalist">2026 Hen Hatch Finalist</span>
<span class="mono-dim">University of Delaware · Expected 2027</span>
</div>
<div class="venture-body">
<div class="venture-main">
<h3 class="venture-heading">Overhead Cable-Driven Robot for Precision Weed Detection & Targeted Spraying</h3>
<p class="venture-desc">
Agri Sky Eye is an overhead robot suspended on cables that detects weeds and sprays only the selected ones in high-value specialty crops. Built for farms up to 10 acres, the system aims to reduce manual weeding labor and help growers manage their crops more efficiently.
</p>
<div class="meta-chips">
<span class="chip">Presenter: Arjun Nanda Kumar (UD Robotics)</span>
<span class="chip">Finals: Dec 3, 2026 @ Blue Hen Innovation Fest</span>
<span class="chip">Format: 7-min Pitch + 5-min Q&A</span>
<span class="chip">$50,000 Prize Pool</span>
</div>
</div>
<div class="venture-cta">
<a
href="https://horn.udel.edu/meet-the-2026-hen-hatch-finalists"
target="_blank"
rel="noopener noreferrer"
class="btn"
>
Read Horn Finalists Article ↗
</a>
</div>
</div>
</div>
</Reveal>
</section>
<!-- 03 // POINT CLOUD SECTION -->
<section id="pointcloud" class="section container">
<Reveal client:visible>
<div class="section-header">
<div>
<p class="eyebrow">03 // LIVE SENSOR DATA</p>
<h2 class="section-title">Interactive LiDAR Point Cloud</h2>
</div>
<span class="section-meta mono-dim">/agility/lidar/points · 24,902 PTS</span>
</div>
</Reveal>
<Reveal client:visible delay={0.08}>
<div class="card pointcloud-shell">
<div class="pointcloud-bar">
<div class="pc-bar-left">
<span class="hud-dot"></span>
<span class="mono-dim">PointCloud2 · Frame #100</span>
</div>
<div class="pc-bar-right mono-dim">
Left-drag: Orbit · Scroll: Zoom · Right-drag: Pan
</div>
</div>
<div class="pointcloud-canvas">
<ModelViewer client:visible src="/models/lidar-scan.glb" height={500} />
</div>
</div>
</Reveal>
</section>
<!-- LAB PHOTO & VIDEO -->
<section id="video" class="section container">
<Reveal client:visible>
<div class="section-header">
<div>
<p class="eyebrow">04 // MEDIA</p>
<h2 class="section-title">Photo & Video</h2>
</div>
<span class="section-meta mono-dim">PHOTO · SCREEN RECORDING</span>
</div>
</Reveal>
<div class="media-grid">
<Reveal client:visible>
<figure class="card media-card">
<img
src="/images/lab-photo-1.jpg"
alt="Cable-suspended robot"
class="media-el"
loading="lazy"
/>
<figcaption class="media-caption mono-dim">
FIG 01 // CABLE-SUSPENDED ROBOT
</figcaption>
</figure>
</Reveal>
<Reveal client:visible delay={0.1}>
<figure class="card media-card">
<video
src="/videos/lab-demo.webm"
autoplay
muted
loop
playsinline
class="media-el"
></video>
<figcaption class="media-caption mono-dim">
FIG 02 // LIDAR POINT CLOUD VISUALIZATION
</figcaption>
</figure>
</Reveal>
</div>
</section>
<!-- 05 // WHERE I'M LISTED -->
<section id="listings" class="section container">
<Reveal client:visible>
<div class="section-header">
<div>
<p class="eyebrow">05 // AFFILIATIONS</p>
<h2 class="section-title">Find Me Across UD</h2>
</div>
<span class="section-meta mono-dim">DEPARTMENT · LABS · VENTURE</span>
</div>
</Reveal>
<div class="listings-grid">
{listings.map((item, i) => (
<Reveal client:visible delay={i * 0.08}>
<a
href={item.href}
target="_blank"
rel="noopener noreferrer"
class="card listing-card"
>
<div class="listing-top">
<div>
<span class="listing-source">{item.source}</span>
<span class="listing-role mono-dim">{item.role}</span>
</div>
<span class="listing-arrow">↗</span>
</div>
<p class="listing-text">{item.text}</p>
</a>
</Reveal>
))}
</div>
</section>
<!-- 06 // CONTACT -->
<section id="contact" class="section container">
<Reveal client:visible>
<div class="card contact-card">
<div class="contact-copy">
<p class="eyebrow">06 // CONTACT</p>
<h2 class="section-title">Get in Touch</h2>
<p class="contact-sub">
Graduate Researcher in Robotics at the University of Delaware (HORC Lab & Ag-CyPhER Lab).
</p>
</div>
<div class="contact-actions">
<a href="mailto:aarjun@udel.edu" class="btn">
aarjun@udel.edu
</a>
<a
href="https://www.linkedin.com/in/arjunnandakumar/"
target="_blank"
rel="noopener noreferrer"
class="btn btn-ghost"
>
LinkedIn ↗
</a>
</div>
</div>
</Reveal>
</section>
</BaseLayout>
