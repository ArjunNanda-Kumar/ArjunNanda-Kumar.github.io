---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.tsx";
import Journey from "../components/Journey.tsx";
import WorkGrid from "../components/WorkGrid.tsx";
import Magnetic from "../components/Magnetic.tsx";
---

<BaseLayout title="Home">
  <section class="hero container">
    <div class="blob"></div>
    <Reveal client:visible>
      <p class="eyebrow">Mechanical engineer &rarr; robotics MS &middot; University of Delaware</p>
      <h1>Engineering things that <span class="accent">sense, move, and hold together.</span></h1>
      <p class="lede">
        I'm Arjun. Trained as a mechanical engineer, pulled into building and
        innovating, and now doing a robotics MS — working on perception for
        the Agility Digit humanoid in the HORC Lab.
      </p>
      <div class="hero-actions">
        <Magnetic client:load href="#work" className="btn" cursorLabel="explore">View the work</Magnetic>
        <Magnetic client:load href="#contact" className="btn btn-ghost" cursorLabel="say hi">Get in touch</Magnetic>
      </div>
      <div class="stat-row">
        <div><div class="stat-num">4</div><div class="stat-label">Journey stages</div></div>
        <div><div class="stat-num">1</div><div class="stat-label">Humanoid robot in lab</div></div>
        <div><div class="stat-num">2</div><div class="stat-label">Disciplines bridged</div></div>
      </div>
    </Reveal>
  </section>

  <section id="about" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">About</p>
      <div class="about-grid">
        <div>
          <h2>From mechanisms to humanoids</h2>
          <p>
            I started out as a mechanical engineer, then got pulled into
            building and innovating — which led to a stint as an Entrepreneur
            in Residence at IIT Palakkad, working on assistive robotic tech.
            That path took me deeper into robotics than any single ME course
            could, so I'm now doing a robotics MS at the University of
            Delaware, going back to the fundamentals — ROS2, Linux, networked
            systems — with none of it wasted, since it all feeds directly
            into the CAD, mechanism design, and perception work I do now.
          </p>
          <p>
            In the HORC (Human-Oriented Robotics and Control) Lab, I work on
            perception and sensing for the Agility Digit humanoid. Outside
            of coursework and lab work, I still like building physical
            things — 3D printing and general hardware tinkering.
          </p>
        </div>
        <dl class="facts">
          <dt>Base</dt><dd>University of Delaware</dd>
          <dt>Trained as</dt><dd>Mechanical engineer</dd>
          <dt>Past role</dt><dd>EIR, IIT Palakkad — assistive robotic tech</dd>
          <dt>Lab</dt><dd>HORC — Agility Digit perception</dd>
          <dt>Also into</dt><dd>CAD, 3D printing, hardware</dd>
        </dl>
      </div>
    </Reveal>
  </section>

  <section id="journey" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Journey</p>
      <h2>How I got here</h2>
      <p class="section-sub">Mechanical engineering was the starting point, not the end state. Drag to scroll &rarr;</p>
    </Reveal>
    <Journey client:visible />
  </section>

  <section id="work" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Work</p>
      <h2>Selected work</h2>
      <p class="section-sub">Filter by area.</p>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <WorkGrid client:visible />
    </Reveal>

    <Reveal client:visible delay={0.15}>
      <div class="project-links">
        <a href="/projects/perception" class="btn btn-ghost">Perception model deep-dive &rarr;</a>
        <a href="/projects/point-cloud" class="btn btn-ghost">3D / point cloud deep-dive &rarr;</a>
        <a href="/projects/agriculture" class="btn btn-ghost">Agricultural lab deep-dive &rarr;</a>
      </div>
    </Reveal>
  </section>

  <section id="media" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">From the Lab</p>
      <h2>A look at the work</h2>
    </Reveal>
    <div class="media-grid">
      <Reveal client:visible delay={0.05}>
        <img src="/images/lab-photo-1.jpg" alt="Lab work" class="media-photo" />
      </Reveal>
      <Reveal client:visible delay={0.1}>
        <video src="/videos/lab-demo.webm" controls class="media-video"></video>
      </Reveal>
    </div>
  </section>

  <section id="contact" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Contact</p>
      <h2>Let's talk</h2>
      <p class="section-sub">Open to research collaborations, robotics projects, and internship conversations.</p>
      <div class="hero-actions">
        <Magnetic client:load href="mailto:you@example.com" className="btn">you@example.com</Magnetic>
        <Magnetic client:load href="https://www.linkedin.com/in/arjunnandakumar/" className="btn btn-ghost" target="_blank" rel="noopener">LinkedIn</Magnetic>
      </div>
    </Reveal>
  </section>
</BaseLayout>

<style>
  .hero { padding: 140px 24px 60px; position: relative; overflow: hidden; }
  .blob {
    position: absolute; width: 560px; height: 560px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(94,234,212,0.18), rgba(94,234,212,0.04) 60%, transparent 75%);
    filter: blur(20px); pointer-events: none; z-index: 0;
    top: -180px; right: -140px;
  }
  .hero > :global(div) { position: relative; z-index: 1; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; color: var(--accent); margin-bottom: 12px; }
  h1 { max-width: 780px; }
  .lede { max-width: 620px; font-size: 1.1rem; margin-top: 20px; }
  .hero-actions { margin-top: 32px; display: flex; gap: 16px; flex-wrap: wrap; }
  .btn-ghost { background: transparent; border-color: var(--border); color: var(--text); }
  .btn-ghost:hover { border-color: var(--accent); background: transparent; color: var(--accent); transform: translateY(-2px); }
  .stat-row { display: flex; gap: 48px; margin-top: 64px; flex-wrap: wrap; }
  .stat-num { font-size: 34px; font-weight: 700; color: var(--text); }
  .stat-label { font-size: 12px; color: var(--text-dim); margin-top: 4px; letter-spacing: 0.04em; text-transform: uppercase; }

  .about-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 60px; align-items: start; margin-top: 24px; }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; } }
  .facts { border-left: 2px solid var(--border); padding-left: 24px; }
  .facts dt { font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 20px; }
  .facts dt:first-child { margin-top: 0; }
  .facts dd { margin: 4px 0 0; font-size: 15px; font-weight: 500; color: var(--text); }

  .section-sub { color: var(--text-dim); font-size: 16px; max-width: 560px; margin-top: 10px; }

  .project-links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 40px; }

  .media-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 32px; }
  @media (max-width: 760px) { .media-grid { grid-template-columns: 1fr; } }
  .media-photo, .media-video {
    width: 100%; border-radius: 14px; border: 1px solid var(--border);
    display: block;
  }
</style>
