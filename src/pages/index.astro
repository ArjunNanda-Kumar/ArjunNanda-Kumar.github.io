---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.tsx";
import ModelViewer from "../components/ModelViewer.tsx";

const listings = [
  {
    source: "UD Mechanical Engineering",
    text: "Listed among graduate students in the MSME program, research area: Robotics.",
    href: "https://me.udel.edu/people/graduate-students/",
  },
  {
    source: "HORC Lab",
    text: "Robotics master's student with a bachelor's in mechanical engineering, working on the perception model for the Agility Digit humanoid robot.",
    href: "https://horc-lab.github.io/people/",
  },
  {
    source: "Ag-CyPhER Lab",
    text: "Listed as a research assistant, MS Robotics, 2026 to present.",
    href: "https://ag-cypher.github.io/website/",
  },
  {
    source: "Horn Entrepreneurship",
    text: "2026 Hen Hatch finalist with Agri Sky Eye, an overhead cable-driven robot for detecting and spraying weeds in high-value specialty crops on farms up to 10 acres. Finals: December 3, 2026.",
    href: "https://horn.udel.edu/meet-the-2026-hen-hatch-finalists",
  },
];

const work = [
  {
    tag: "HORC Lab",
    title: "Perception on Agility Digit",
    desc: "Working on the perception and sensing layer for the lab's Agility Digit humanoid.",
  },
  {
    tag: "HORC Lab",
    title: "Lidar streaming bottleneck",
    desc: "Diagnosed a frame-rate cap in a ROS2 node streaming lidar and camera data over TCP/WebSockets — traced it to the state machine, buffer size, and ack-based flow control, then proposed a restructured drain-loop fix.",
  },
  {
    tag: "Robotics course",
    title: "IMU pipeline on Raspberry Pi",
    desc: "Full sensor-to-analysis pipeline on a Pi Zero 2W — a ROS2 node processing live IMU data, logged to CSV and plotted with pandas and matplotlib.",
  },
];
---

<BaseLayout title="Home">
  <section class="hero container">
    <div class="hero-grid">
      <Reveal client:load>
        <p class="eyebrow">Mechanical engineer &rarr; robotics MS &middot; University of Delaware</p>
        <h1>Engineering things that <span class="accent">sense, move, and hold together.</span></h1>
        <p class="lede">
          I'm Arjun. Trained as a mechanical engineer, pulled into building and
          innovating, and now doing a robotics MS — working on perception for
          the Agility Digit humanoid in the HORC Lab.
        </p>
        <div class="hero-actions">
          <a href="#work" class="btn">View the work</a>
          <a href="#contact" class="btn btn-ghost">Get in touch</a>
        </div>
      </Reveal>
      <Reveal client:load delay={0.15}>
        <div class="hero-photo-wrap">
          <img src="/images/profile.png" alt="Arjun Nanda Kumar" class="hero-photo" />
        </div>
      </Reveal>
    </div>
  </section>

  <section id="work" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Work</p>
      <h2>Selected work</h2>
    </Reveal>
    <div class="work-grid">
      {work.map((item, i) => (
        <Reveal client:visible delay={i * 0.08}>
          <div class="card">
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <section id="venture" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Venture</p>
      <h2>Agri Sky Eye</h2>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <div class="card venture-card">
        <span class="badge">2026 Hen Hatch Finalist</span>
        <p class="venture-desc">
          An overhead robot on cables that detects weeds and sprays only the
          selected ones in high-value specialty crops. Built for farms of up
          to 10 acres, it aims to reduce manual weeding labor and help
          growers manage their crops more efficiently.
        </p>
        <div class="venture-meta">
          <span>Presenter: Arjun Nanda Kumar</span>
          <span>University of Delaware, Robotics</span>
          <span>Finals: Dec 3, 2026, Blue Hen Innovation Fest</span>
          <span>Hen Hatch: $50,000 in cash and prizes</span>
        </div>
        <a
          href="https://horn.udel.edu/meet-the-2026-hen-hatch-finalists"
          class="btn"
          target="_blank"
          rel="noopener"
        >Read the announcement &rarr;</a>
      </div>
    </Reveal>
  </section>

  <section id="pointcloud" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Lidar Scan</p>
      <h2>A real point cloud from the lab</h2>
      <p class="section-sub">Captured from the Agility Digit's lidar. Drag to rotate, scroll to zoom.</p>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <ModelViewer client:visible src="/models/lidar-scan.glb" />
    </Reveal>
  </section>

  <section id="photo" class="section container">
    <Reveal client:visible>
      <img src="/images/lab-photo-1.jpg" alt="Arjun in the lab" class="mid-photo" />
    </Reveal>
  </section>

  <section id="video" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">From the Lab</p>
      <h2>A look at the work</h2>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <video src="/videos/lab-demo.webm" autoplay muted loop playsinline class="media-video"></video>
    </Reveal>
  </section>

  <section id="listings" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Find me online</p>
      <h2>Where I'm listed</h2>
    </Reveal>
    <div class="listing-grid">
      {listings.map((l, i) => (
        <Reveal client:visible delay={i * 0.07}>
          <a href={l.href} class="card listing" target="_blank" rel="noopener">
            <span class="listing-src">{l.source}</span>
            <p class="listing-text">{l.text}</p>
            <span class="listing-go">Open page &rarr;</span>
          </a>
        </Reveal>
      ))}
    </div>
  </section>

  <section id="contact" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Contact</p>
      <h2>Let's talk</h2>
    </Reveal>
  </section>
</BaseLayout>

<style>
  .hero { padding: 130px 24px 70px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
  }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo-wrap { max-width: 280px; }
  }
  .hero-photo-wrap {
    position: relative;
    max-width: 340px;
    margin: 0 auto;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(160deg, rgba(94,234,212,0.06), rgba(255,255,255,0.02));
  }
  .hero-photo {
    width: 100%;
    max-height: 440px;
    object-fit: contain;
    object-position: bottom;
    filter: grayscale(1) contrast(1.08);
    border-radius: 10px;
    transition: filter 0.4s ease;
  }
  .hero-photo-wrap:hover .hero-photo {
    filter: grayscale(0.15) contrast(1.05);
  }
  .lede { max-width: 620px; font-size: 1.08rem; margin-top: 18px; display: block; }
  .hero-actions { margin-top: 30px; display: flex; gap: 16px; flex-wrap: wrap; }

  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 28px; }
  @media (max-width: 860px) { .work-grid { grid-template-columns: 1fr; } }
  .tag {
    font-family: monospace; font-size: 11px; color: var(--accent);
    background: rgba(94,234,212,0.08); padding: 4px 10px; border-radius: 100px;
    display: inline-block; margin-bottom: 14px;
  }
  .work-grid h3 { font-size: 17px; margin-bottom: 8px; }
  .work-grid p { font-size: 13.5px; }

  .venture-card { margin-top: 24px; max-width: 760px; }
  .badge {
    display: inline-block; font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
    color: var(--bg); background: var(--accent);
    padding: 5px 12px; border-radius: 100px; margin-bottom: 16px;
  }
  .venture-desc { font-size: 1.02rem; color: var(--text); }
  .venture-meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 24px; }
  .venture-meta span {
    font-size: 12px; font-family: monospace; color: var(--text-dim);
    border: 1px solid var(--border); padding: 4px 10px; border-radius: 100px;
  }

  .listing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 24px; }
  @media (max-width: 760px) { .listing-grid { grid-template-columns: 1fr; } }
  .listing {
    display: block; text-decoration: none; height: 100%;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .listing:hover { border-color: var(--accent); transform: translateY(-3px); }
  .listing-src { font-family: monospace; font-size: 12px; color: var(--accent); letter-spacing: 0.04em; }
  .listing-text { font-size: 14px; margin: 10px 0 14px; }
  .listing-go { font-size: 13px; font-weight: 600; color: var(--text); }

  .section-sub { color: var(--text-dim); font-size: 15px; max-width: 560px; margin-top: 8px; display: block; }

  .mid-photo {
    width: 100%; max-height: 520px; object-fit: cover;
    border-radius: 16px; border: 1px solid var(--border);
  }

  .media-video {
    width: 100%; max-width: 880px; margin-top: 24px;
    border: 1px solid var(--border);
  }
</style>
