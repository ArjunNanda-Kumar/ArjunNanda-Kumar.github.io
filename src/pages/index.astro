---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.tsx";
import ModelViewer from "../components/ModelViewer.tsx";

const work = [
  {
    tag: "HORC Lab",
    title: "Perception on Agility Digit",
    desc: "Working on the perception and sensing layer for the lab's Agility Digit humanoid.",
  },
  {
    tag: "HORC Lab",
    title: "Lidar streaming bottleneck",
    desc: "Diagnosed a frame-rate cap in a ROS2 node streaming lidar and camera data over TCP/WebSockets — traced it to the state machine, buffer size, and ack-based flow control, then proposed a restructured drain-loop fix.",
  },
  {
    tag: "Robotics course",
    title: "IMU pipeline on Raspberry Pi",
    desc: "Full sensor-to-analysis pipeline on a Pi Zero 2W — a ROS2 node processing live IMU data, logged to CSV and plotted with pandas and matplotlib.",
  },
];
---

<BaseLayout title="Home">
  <section class="hero container">
    <Reveal client:load>
      <p class="eyebrow">Mechanical engineer &rarr; robotics MS &middot; University of Delaware</p>
      <h1>Engineering things that <span class="accent">sense, move, and hold together.</span></h1>
      <p class="lede">
        I'm Arjun. Trained as a mechanical engineer, pulled into building and
        innovating, and now doing a robotics MS — working on perception for
        the Agility Digit humanoid in the HORC Lab.
      </p>
      <div class="hero-actions">
        <a href="#work" class="btn">View the work</a>
        <a href="#contact" class="btn btn-ghost">Get in touch</a>
      </div>
    </Reveal>
  </section>

  <section id="work" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Work</p>
      <h2>Selected work</h2>
    </Reveal>
    <div class="work-grid">
      {work.map((item, i) => (
        <Reveal client:visible delay={i * 0.08}>
          <div class="card">
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <section id="pointcloud" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Lidar Scan</p>
      <h2>A real point cloud from the lab</h2>
      <p class="section-sub">Captured from the Agility Digit's lidar. Drag to rotate, scroll to zoom.</p>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <ModelViewer client:visible src="/models/lidar-scan.glb" />
    </Reveal>
  </section>

  <section id="photo" class="section container">
    <Reveal client:visible>
      <img src="/images/lab-photo-1.jpg" alt="Arjun in the lab" class="mid-photo" />
    </Reveal>
  </section>

  <section id="video" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">From the Lab</p>
      <h2>A look at the work</h2>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <video src="/videos/lab-demo.webm" autoplay muted loop playsinline controls class="media-video"></video>
    </Reveal>
  </section>

  <section id="contact" class="section container">
    <Reveal client:visible>
      <p class="eyebrow">Contact</p>
      <h2>Let's talk</h2>
    </Reveal>
  </section>
</BaseLayout>

<style>
  .hero { padding: 130px 24px 70px; }
  .lede { max-width: 620px; font-size: 1.08rem; margin-top: 18px; display: block; }
  .hero-actions { margin-top: 30px; display: flex; gap: 16px; flex-wrap: wrap; }

  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 28px; }
  @media (max-width: 860px) { .work-grid { grid-template-columns: 1fr; } }
  .tag {
    font-family: monospace; font-size: 11px; color: var(--accent);
    background: rgba(94,234,212,0.08); padding: 4px 10px; border-radius: 100px;
    display: inline-block; margin-bottom: 14px;
  }
  .work-grid h3 { font-size: 17px; margin-bottom: 8px; }
  .work-grid p { font-size: 13.5px; }

  .section-sub { color: var(--text-dim); font-size: 15px; max-width: 560px; margin-top: 8px; display: block; }

  .mid-photo {
    width: 100%; max-height: 520px; object-fit: cover;
    border-radius: 16px; border: 1px solid var(--border);
  }

  .media-video {
    width: 100%; max-width: 880px; margin-top: 24px;
    border: 1px solid var(--border);
  }
</style>
